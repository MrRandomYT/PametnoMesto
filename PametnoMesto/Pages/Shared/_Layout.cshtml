@using PametnoMesto.Scripts
@inject DataHandler DataHandler

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />    
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PametnoMesto</title>
    <link rel="stylesheet" href="~/lib/leaflet/dist/leaflet.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">PametnoMesto</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Vehicles">Vehicles</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/VehicleHubs">Vehicle Hubs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/VehicleHubMap">Hub Map</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                        <li class="nav-item ms-auto d-flex align-items-center">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                // 1. Poiščemo prijavljenega uporabnika
                                var currentUser = DataHandler.GetPlayerByUsername(User.Identity.Name);
                            
                                // 2. Če uporabnik obstaja, izpišemo stanje denarnice
                                if (currentUser != null)
                                {
                                    // Uporabljam 'text-dark', ker imaš tako nastavljeno v svoji kodi.
                                    // Če bo slabo vidno na temnem ozadju, spremeni 'text-dark' v 'text-white'.
                                    <span class="nav-link text-dark fw-bold me-2">
                                        Denarnica: @currentUser.Balance.ToString("C")
                                    </span>
                                }

                                // 3. Gumb za odjavo (ostane enak kot prej)
                                <form method="post" asp-page="/Logout" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link text-dark border-0 bg-transparent">
                                        Logout (@User.Identity.Name)
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a class="nav-link text-dark" asp-page="/Login">Login</a>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - PametnoMesto - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/leaflet/dist/leaflet.js"></script>
    <script src="/js/mapLoader.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>