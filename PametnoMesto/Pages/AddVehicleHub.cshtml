@page
@model AddVehicleHubModel
@{
    ViewData["Title"] = "Add Vehicle Hub";
}

<div class="text-center">
    <h1>Add a Vehicle Hub</h1>
</div>

<form method="post">
    <div class="mb-3">
        <label for="Name" class="form-label">Name</label>
        <input type="text" id="Name" asp-for="Name" class="form-control" required />
    </div>
    
    <input type="hidden" id="Latitude" name="Latitude" asp-for="Latitude" />
    <input type="hidden" id="Longitude" name="Longitude" asp-for="Longitude" />
    <div id="map" style="height: 400px; margin-bottom: 1rem;"
         data-lat="@Model.Latitude"
         data-lng="@Model.Longitude"></div>

    <div class="mb-3">
        <label for="Capacity" class="form-label">Capacity</label>
        <input type="number" id="Capacity" asp-for="Capacity" class="form-control" min="1" required />
    </div>

    <div class="mb-3">
        <label for="Status" class="form-label">Status</label>
        <select id="Status" asp-for="Status" class="form-select">
            <option value="Closed">Closed</option>
            <option value="Open">Open</option>
        </select>
    </div>

    <button type="submit" class="btn btn-success">Add Hub</button>
    <a class="btn btn-secondary" asp-page="/VehicleHubs">Cancel</a>
</form>