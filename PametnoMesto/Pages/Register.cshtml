@page
@model PametnoMesto.Pages.RegisterModel
@{
    ViewData["Title"] = "Registracija";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark text-white border-secondary shadow">
                <div class="card-header border-secondary bg-primary text-white">
                    <h3 class="mb-0">Ustvari nov račun</h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label">Uporabniško ime</label>
                            <input type="text" asp-for="Username" class="form-control bg-secondary text-white border-0" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Geslo</label>
                            <input type="password" asp-for="Password" class="form-control bg-secondary text-white border-0" required />
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger">@Model.ErrorMessage</div>
                        }

                        <button type="submit" class="btn btn-success w-100 mb-3">Registriraj se</button>
                    </form>

                    <div class="text-center border-top border-secondary pt-3">
                        <small class="text-white-50">Že imaš račun? 
                            <a asp-page="/Login" class="fw-bold text-info text-decoration-none">Prijavi se tukaj</a>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>